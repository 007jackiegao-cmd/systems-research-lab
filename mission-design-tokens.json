{
  "schemaVersion": 1,
  "name": "MISSION OS Enterprise v2",
  "date": "2000-01-01",
  "source": "mission-styles.css; actual CSS values with later overrides applied",
  "baselineViewport": {
    "width": 1440,
    "height": 900,
    "unit": "px"
  },
  "cssVariables": {
    "--shell": "#f4f5f6",
    "--surface": "#ffffff",
    "--ink": "#202124",
    "--muted": "#60656c",
    "--line": "#e2e5e8",
    "--selected": "#e8f0fe",
    "--blue": "#2457d6",
    "--blue-dark": "#1943ad",
    "--green": "#256c55",
    "--amber": "#915c16",
    "--red": "#b13c42",
    "--canvas": "#22282e",
    "--nav": "224px",
    "--radius": "6px",
    "--font": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif"
  },
  "colors": {
    "shell": "#f4f5f6",
    "surface": "#ffffff",
    "sidebar": "#f0f2f4",
    "topbar": "#fafbfc",
    "textPrimary": "#202124",
    "textSecondary": "#60656c",
    "border": "#e2e5e8",
    "primaryAction": "#2457d6",
    "primaryActionHover": "#1943ad",
    "navigationSelectedBackground": "#e3ebf9",
    "navigationSelectedText": "#214bb4",
    "tableSelectedBackground": "#eef4ff",
    "tableSelectedIndicator": "#3371e3",
    "canvasVariable": "#22282e",
    "photoStage": "#232a30",
    "canvasStatus": "#2b333b",
    "roiBorder": "#43b1fc",
    "roiLabel": "#2375aa",
    "focusOutline": "#82adff",
    "disabledText": "#969ca5",
    "disabledBackground": "#edf0f3",
    "disabledPrimaryBackground": "#c6d3ee",
    "statuses": {
      "blue": {
        "text": "#1e56bd",
        "background": "#e9f0fe"
      },
      "amber": {
        "text": "#8d5d20",
        "background": "#fff4e3"
      },
      "green": {
        "text": "#286c58",
        "background": "#e8f4ee"
      },
      "red": {
        "text": "#a1353e",
        "background": "#fcecef"
      },
      "gray": {
        "text": "#60656c",
        "background": "#eef0f2"
      }
    }
  },
  "typography": {
    "fontFamily": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
    "monospaceFamily": "ui-monospace,SFMono-Regular,Menlo,monospace",
    "body": {
      "size": 14,
      "lineHeight": 1.5,
      "weight": 400
    },
    "pageTitle": {
      "size": 24,
      "weight": 600,
      "letterSpacing": "-0.02em"
    },
    "sectionTitle": {
      "size": 16,
      "weight": 600
    },
    "surfaceSectionTitle": {
      "size": 15,
      "weight": 600
    },
    "subsectionTitle": {
      "size": 14,
      "weight": 600
    },
    "reviewCaseTitle": {
      "size": 20,
      "weight": 600,
      "lineHeight": 1.5
    },
    "taskName": {
      "size": 14,
      "weight": 500
    },
    "action": {
      "size": 14,
      "weight": 500
    },
    "status": {
      "size": 14,
      "weight": 400
    },
    "tableHeader": {
      "size": 13,
      "weight": 500
    },
    "metadata": {
      "size": 13,
      "weight": 400
    },
    "code": {
      "size": 12,
      "color": "#60656c"
    },
    "taskCode": {
      "size": 11
    },
    "imageCaption": {
      "size": 11,
      "color": "#60656c"
    },
    "roiLabel": {
      "size": 11,
      "lineHeight": 1.5
    },
    "languageSelector": {
      "size": 13
    }
  },
  "layout": {
    "desktop": {
      "sidebarWidth": 224,
      "topbarHeight": 48,
      "contentPadding": 24,
      "contentMaxWidth": 1760,
      "workbench": {
        "columns": "minmax(0,1fr) 328px",
        "gap": 20
      },
      "prepare": {
        "columns": "minmax(0,1fr) 310px",
        "gap": 20
      },
      "planFormAbove1080": {
        "columns": "repeat(3,minmax(0,1fr))",
        "rowGap": 12,
        "columnGap": 16
      },
      "observe": {
        "columns": "minmax(0,1fr) 300px",
        "gap": 20
      },
      "review": {
        "columns": "240px minmax(0,1fr) 300px",
        "gap": 16
      },
      "record": {
        "columns": "minmax(0,1fr) 310px",
        "gap": 20
      },
      "settings": {
        "columns": "210px minmax(0,750px)",
        "gap": 20
      },
      "photoStageHeight": 470,
      "photoStagePadding": 24
    },
    "responsive": [
      {
        "maxWidth": 1250,
        "reviewColumns": "200px minmax(0,1fr) 270px",
        "reviewGap": 12,
        "observeInspectorWidth": 280
      },
      {
        "maxWidth": 1200,
        "sidebarWidth": 190,
        "contentPadding": 20,
        "workbenchInspectorWidth": 300
      },
      {
        "maxWidth": 1080,
        "taskDetailColumns": 1,
        "observeColumns": 1,
        "reviewColumns": "200px minmax(0,1fr)",
        "decisionPanelColumn": 2,
        "photoStageHeight": 420
      },
      {
        "maxWidth": 980,
        "workbenchColumns": 1
      },
      {
        "maxWidth": 760,
        "sidebarWidth": 0,
        "navigation": "inline work navigation; auxiliary groups hidden",
        "contentPadding": "18px 14px",
        "taskDetailColumns": 1,
        "reviewColumns": 1,
        "reviewQueue": "hidden",
        "photoStageHeight": 340,
        "photoStagePadding": 14,
        "languageSelectorMaxWidth": 100
      }
    ]
  },
  "radii": {
    "control": 5,
    "button": 6,
    "surface": 8,
    "status": 4,
    "dialog": 9
  },
  "spacing": {
    "sectionGap": 20,
    "reviewColumnGap": 16,
    "smallActionGap": 8,
    "dialogContentPadding": 22,
    "formBodyPadding": 20
  },
  "components": {
    "navigationItem": {
      "minHeight": 40,
      "padding": "8px 12px",
      "iconSize": 17
    },
    "button": {
      "minHeight": 34,
      "padding": "6px 12px",
      "iconSize": 16,
      "borderWidth": 1
    },
    "smallButton": {
      "minHeight": 30,
      "padding": "4px 9px",
      "fontSize": 13
    },
    "iconButton": {
      "width": 32,
      "height": 32
    },
    "status": {
      "padding": "3px 8px",
      "radius": 4
    },
    "table": {
      "defaultCellHeight": 54,
      "defaultCellPadding": 12,
      "rowHeightBehavior": "expands for two-line task identity",
      "compactCellHeight": 44,
      "compactCellPadding": "7px 12px"
    },
    "field": {
      "minHeight": 36,
      "padding": "7px 10px",
      "radius": 5,
      "labelFontSize": 13
    },
    "languageSelector": {
      "minHeight": 30,
      "maxWidth": 122,
      "padding": "3px 23px 3px 8px"
    },
    "roi": {
      "borderWidth": 2,
      "coordinateUnit": "percent of full original image",
      "labelOffsetTop": -25,
      "imageFit": "contain",
      "zoomRange": [
        1,
        2
      ]
    },
    "operationInspector": {
      "formBodyPadding": "12px 20px",
      "propertyListMargin": "10px 0",
      "propertyListGap": 6,
      "dividerMargin": "10px 0",
      "textareaMinHeight": 56,
      "textareaHeight": 60
    },
    "filmstripThumbnail": {
      "width": 65,
      "height": 40,
      "fit": "cover"
    },
    "dialog": {
      "defaultWidth": 580,
      "wideWidth": 900,
      "maxHeight": "90vh",
      "viewportGutter": 32
    },
    "focus": {
      "outlineWidth": 3,
      "outlineOffset": 2
    }
  },
  "internationalization": {
    "languages": [
      {
        "code": "zh",
        "label": "\u4e2d\u6587",
        "documentLang": "zh-CN"
      },
      {
        "code": "en",
        "label": "English",
        "documentLang": "en"
      },
      {
        "code": "fr",
        "label": "Fran\u00e7ais",
        "documentLang": "fr"
      },
      {
        "code": "ja",
        "label": "\u65e5\u672c\u8a9e",
        "documentLang": "ja"
      }
    ],
    "preserve": [
      "route",
      "task",
      "filters",
      "selection",
      "evidence",
      "zoom",
      "ROI draft",
      "unsaved form values",
      "notes",
      "review text",
      "consent",
      "focus"
    ],
    "userContent": "keep original text; never translate stored user names, task text, file names or opinions",
    "optionValues": "explicit and stable; translate visible labels only",
    "businessEvents": "language switching does not create task events or invalidate approval"
  },
  "contentRules": [
    "Object navigation, actionable labels and necessary statuses",
    "No KPI wall, decorative progress rings, explanatory subtitle pile or marketing hero",
    "No fabricated telemetry, device connection, physical command or completion",
    "Initial photography is generated reference material, not field evidence",
    "Help and integration boundaries belong in help, settings and documentation"
  ],
  "verificationScope": "Tokens are extracted from source CSS. Browser import/file chooser and backup restore have not completed end-to-end browser acceptance. See final review records for verified scope."
}
